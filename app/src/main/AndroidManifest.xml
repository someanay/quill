<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions per spec.md §5. Runtime/special grants are requested in onboarding (M8);
         declared here so the scaffold reflects the full permission model from the start. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- M1: the bubble FGS runs as specialUse (no recorder yet). Switches to the microphone type
         at M4 when OverlayService owns the AudioRecorder (spec §3.1 / §5). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Contacts vocabulary import (Phase 1, feature #6 re-scoped to contacts only). Opt-in:
         requested only from the Settings contacts-vocabulary row when the user taps "Import from
         contacts" — never during onboarding, never automatically. Display names are filtered and
         stored on-device only; no network call touches them. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Deliberately NOT requested: QUERY_ALL_PACKAGES (spec.md §5); and
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS (M12) — Play restricts the one-tap exemption request to an
         allowlist a BYOK dictation app doesn't qualify for, so we only deep-link to the battery
         settings list and let the user allow Quill there. -->

    <!-- Package visibility for the per-app writing-style picker. On API 30+ the installed-app list is
         filtered; this <queries> element makes exactly the user-LAUNCHABLE apps visible, which is
         precisely the set you can dictate into. It is the non-restricted alternative to
         QUERY_ALL_PACKAGES, which Play grants only to launchers/security/file-manager apps and which
         this app must never request (see the note above, and M12's precedent). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Quill">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Quill">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hosts the floating bubble overlay (M1). foregroundServiceType becomes "microphone" at
             M4 when it also owns the recorder (spec §3.1 / §5). -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_dictation_bubble_overlay" />
        </service>

        <!-- Prominent disclosure shown before enabling the accessibility service (spec §8). -->
        <activity
            android:name=".accessibility.AccessibilityDisclosureActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Quill" />

        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Quill" />

        <!-- Reboot survival (M11): restores the bubble (or posts a re-activate notification) after a
             reboot. Never force-starts the mic FGS from boot. directBootAware=false: we only need to
             run after the user unlocks. exported=true is required to receive the system boot broadcast. -->
        <receiver
            android:name=".reliability.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Accessibility service: detects the focused field + (from M3) inserts dictation.
             Gated by the system BIND_ACCESSIBILITY_SERVICE permission; config in res/xml. -->
        <service
            android:name=".accessibility.QuillAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>

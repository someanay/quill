<?xml version="1.0" encoding="utf-8"?>
<!--
  Secrets are EXCLUDED from cloud backup and device transfer (spec §6): the Keystore key can't be
  restored, so the encrypted blob would be undecryptable garbage. We exclude the secrets dir and the
  settings DataStore. (Android 12+ uses these rules.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="secrets/" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="quill_history.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="secrets/" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="quill_history.db" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 Auto Backup rules. Exclude secrets + settings (spec §6) — the Keystore key can't be
  restored, so a restored ciphertext is useless and must not be backed up.
-->
<full-backup-content>
    <exclude domain="file" path="secrets/" />
    <exclude domain="file" path="datastore/" />
    <!-- Legacy copy cache from older versions: never used or restored. -->
    <exclude domain="file" path="copy/" />
    <!-- Dictation history stays on this device only (M9). -->
    <exclude domain="database" path="quill_history.db" />
    <!-- Crash reports (M11): local-only, user-reviewable; must not transfer. -->
    <exclude domain="file" path="crash/" />
</full-backup-content>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Shared App Group: settings, history, and recordings live in this container so the main app and
         the Quill keyboard extension read/write the same data. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.tihor.quill</string>
    </array>
    <!-- To share API keys with the keyboard extension via Keychain, ALSO add a keychain group here and
         in the keyboard's entitlements, then set SecretStore.accessGroup to the same team-prefixed
         value. Example (uncomment and set your group):
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.tihor.quill.keys</string>
    </array>
    -->
</dict>
</plist>

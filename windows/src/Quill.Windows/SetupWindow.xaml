<Window x:Class="Quill.Windows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Quill.Windows.Controls"
        Title="Set up Quill" Width="1040" Height="700" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="{StaticResource Board}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="30,32">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource Brand}">
                            <TextBlock Text="Q" FontFamily="{StaticResource WordmarkFont}" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Quill" FontFamily="{StaticResource WordmarkFont}" FontSize="28" FontWeight="Bold" Margin="11,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="FIRST-RUN SETUP" Style="{StaticResource Eyebrow}" Margin="0,36,0,15"/>
                    <TextBlock x:Name="RailStep0" Text="01  Welcome" FontSize="14" FontWeight="SemiBold" Margin="0,8"/>
                    <TextBlock x:Name="RailStep1" Text="02  Speech provider" FontSize="14" FontWeight="SemiBold" Margin="0,8"/>
                    <TextBlock x:Name="RailStep2" Text="03  Shortcut" FontSize="14" FontWeight="SemiBold" Margin="0,8"/>
                    <TextBlock x:Name="RailStep3" Text="04  Privacy" FontSize="14" FontWeight="SemiBold" Margin="0,8"/>
                    <TextBlock x:Name="RailStep4" Text="05  Ready" FontSize="14" FontWeight="SemiBold" Margin="0,8"/>
                </StackPanel>
                <Border Grid.Row="2" Background="{StaticResource SignalSoft}" CornerRadius="14" Padding="16">
                    <StackPanel>
                        <TextBlock Text="PRIVATE BY CONSTRUCTION" Foreground="{StaticResource SignalInk}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="No Quill account. No Quill data server. Your key stays encrypted on this PC." Foreground="{StaticResource Ink2}" FontSize="12" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="48,36,48,30">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="StepCounter" Text="STEP 1 OF 5" Style="{StaticResource Eyebrow}"/>

            <Grid Grid.Row="1" Margin="0,18,0,20">
                <ScrollViewer x:Name="Step0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Your voice, wherever you type." FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text="Quill turns a global shortcut into clean text in the app you were already using." Foreground="{StaticResource Muted}" FontSize="16" Margin="0,10,0,24"/>
                        <controls:DemoCarousel AssetFolder="Setup" Height="270"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="① Press the shortcut" Foreground="{StaticResource Ink2}"/>
                            <TextBlock Grid.Column="1" Text="② Speak naturally" Foreground="{StaticResource Ink2}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="③ Quill types it" Foreground="{StaticResource Ink2}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="Step1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Connect your speech provider." FontSize="32" FontWeight="Bold"/>
                        <TextBlock Text="Quill is bring-your-own-key: without a provider key, it cannot transcribe. Your key is encrypted for this Windows account and never sent to us." Foreground="{StaticResource Muted}" FontSize="15" Margin="0,9,0,22"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Provider" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SetupProvider" Grid.Column="1" SelectionChanged="SetupProvider_SelectionChanged"/>
                                <TextBlock Grid.Row="1" Text="Model" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,15,0,0"/>
                                <ComboBox x:Name="SetupModel" Grid.Row="1" Grid.Column="1" Margin="0,15,0,0"/>
                                <TextBlock x:Name="SetupCustomEndpointLabel" Grid.Row="2" Text="Custom HTTPS endpoint" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,15,0,0"/>
                                <TextBox x:Name="SetupCustomBaseUrl" Grid.Row="2" Grid.Column="1" Margin="0,15,0,0" ToolTip="Required only for the Custom provider"/>
                                <TextBlock Grid.Row="3" Text="API key" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,15,0,0"/>
                                <PasswordBox x:Name="SetupKey" Grid.Row="3" Grid.Column="1" Margin="0,15,0,0" PasswordChanged="SetupKey_PasswordChanged"/>
                                <Border x:Name="SetupKeyStatusCard" Grid.Row="4" Grid.Column="1" CornerRadius="9" Padding="10,7" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="SetupKeyStatus" FontSize="12"/>
                                        <Button x:Name="SetupProviderLink" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                Padding="10,5" Margin="0,8,0,0" Click="OpenProviderConsole_Click"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Row="5" Text="AI cleanup" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,18,0,0"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,15,0,0">
                                    <CheckBox x:Name="SetupCleanup" Content="Improve punctuation and remove false starts"/>
                                    <TextBlock x:Name="SetupCleanupHelp" Foreground="{StaticResource Muted}" FontSize="12" Margin="24,-2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Row="6" Text="Cleanup model" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,15,0,0"/>
                                <ComboBox x:Name="SetupCleanupModel" Grid.Row="6" Grid.Column="1" Margin="0,15,0,0"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource SignalSoft}" CornerRadius="12" Padding="15" Margin="0,14,0,0">
                            <TextBlock Foreground="{StaticResource SignalInk}" Text="Provider usage may cost money. Quill itself does not charge for transcription and never receives your key."/>
                        </Border>
                        <TextBlock x:Name="SetupError" Foreground="{StaticResource Error}" FontWeight="SemiBold" Margin="2,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="Step2" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <TextBlock Text="One shortcut. Any ordinary text field." FontSize="32" FontWeight="Bold"/>
                        <TextBlock Text="Focus where you want the words, then use the shortcut to start and finish." Foreground="{StaticResource Muted}" FontSize="15" Margin="0,9,0,28"/>
                        <Border Style="{StaticResource Card}" Padding="30">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="GLOBAL DICTATION SHORTCUT" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center"/>
                                <TextBox x:Name="SetupShortcut" Width="260" Margin="0,22,0,12" IsReadOnly="True"
                                         TextAlignment="Center" FontSize="18" FontFamily="{StaticResource UtilityFont}"
                                         FontWeight="Bold" PreviewKeyDown="SetupShortcut_PreviewKeyDown"/>
                                <TextBlock Text="Click the shortcut, then press a modifier and key." Foreground="{StaticResource BrandInk}"
                                           HorizontalAlignment="Center" Margin="0,0,0,18"/>
                                <TextBlock Text="Quill listens only after you press it. Press it again to finish." Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Windows blocks typing into administrator-elevated apps. In that case, Quill safely copies the transcript so you can paste it." Foreground="{StaticResource Muted}" Margin="2,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="Step3" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <TextBlock Text="Choose what stays on this PC." FontSize="32" FontWeight="Bold"/>
                        <TextBlock Text="Audio is temporary and deleted after transcription. History is optional and local." Foreground="{StaticResource Muted}" FontSize="15" Margin="0,9,0,24"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="SetupHistory" Content="Keep a local dictation history"/>
                                <TextBlock Text="Default retention is one hour. You can change it later." Foreground="{StaticResource Muted}" FontSize="12" Margin="24,-2,0,10"/>
                                <CheckBox x:Name="SetupStartup" Content="Start Quill when I sign in"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource OkaySoft}" CornerRadius="12" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="KEY" Foreground="{StaticResource Okay}" FontWeight="Bold"/><TextBlock Text="DPAPI encrypted" Foreground="{StaticResource Ink2}" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Grid.Column="1" Background="{StaticResource OkaySoft}" CornerRadius="12" Padding="14" Margin="4,0"><StackPanel><TextBlock Text="AUDIO" Foreground="{StaticResource Okay}" FontWeight="Bold"/><TextBlock Text="Deleted after use" Foreground="{StaticResource Ink2}" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Grid.Column="2" Background="{StaticResource OkaySoft}" CornerRadius="12" Padding="14" Margin="8,0,0,0"><StackPanel><TextBlock Text="BACKEND" Foreground="{StaticResource Okay}" FontWeight="Bold"/><TextBlock Text="None for your data" Foreground="{StaticResource Ink2}" Margin="0,5,0,0"/></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="Step4" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <Border Width="92" Height="92" CornerRadius="46" Background="{StaticResource OkaySoft}"><TextBlock Text="✓" Foreground="{StaticResource Okay}" FontSize="45" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="Quill is ready." FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,8"/>
                        <TextBlock x:Name="ReadyInstruction" Foreground="{StaticResource Muted}" FontSize="15" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Button x:Name="BackButton" Content="Back" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="Back_Click"/>
                <Button x:Name="NextButton" Content="Continue" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="128" Click="Next_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>

<UserControl x:Class="Quill.Windows.Controls.DemoCarousel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Unloaded="OnUnloaded">
    <Border Background="{StaticResource Sunken}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
        <Grid>
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill" IsMuted="True" MediaEnded="Player_MediaEnded"/>
            <Grid x:Name="EmptyState" Background="{StaticResource Sunken}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource BrandSoft}">
                        <TextBlock Text="▶" Foreground="{StaticResource BrandInk}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                    </Border>
                    <TextBlock Text="DESKTOP DEMO · 16:9" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                    <TextBlock Text="Add 1280 × 720 MP4 clips to this carousel" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
            <Border x:Name="Controls" VerticalAlignment="Bottom" Background="#B3090B15" Padding="14,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="‹" Style="{StaticResource GhostButton}" Padding="12,5" Click="Previous_Click"/>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="ClipTitle" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Position" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="›" Style="{StaticResource GhostButton}" Padding="12,5" Click="Next_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

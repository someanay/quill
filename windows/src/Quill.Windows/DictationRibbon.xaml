<Window x:Class="Quill.Windows.DictationRibbon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowActivated="False" ShowInTaskbar="False">
    <StackPanel>
    <Border x:Name="ToastPill" Visibility="Collapsed" Background="#F229264B" CornerRadius="14" Padding="14,9" Margin="0,0,0,8"
            BorderBrush="#554A3FD0" BorderThickness="1" HorizontalAlignment="Right">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.25" Color="#11111A"/></Border.Effect>
        <TextBlock x:Name="ToastText" Foreground="#DDE0F0" FontSize="12" TextWrapping="Wrap" MaxWidth="330"/>
    </Border>
    <Border x:Name="RibbonSurface" Background="#F21C1B33" CornerRadius="22" Padding="16" BorderBrush="#334A3FD0" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform x:Name="RibbonScale"/></Border.RenderTransform>
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.28" Color="#11111A"/></Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="SignalOrb" Width="44" Height="44" CornerRadius="15" Background="{StaticResource Brand}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="OrbScale"/></Border.RenderTransform>
                <Path Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stroke="White" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M9,6 A3,3 0 0 1 15,6 V11 A3,3 0 0 1 9,11 Z M5,11 A7,7 0 0 0 19,11 M12,18 V21"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,2,12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="RibbonTitle" Text="Listening" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <Border x:Name="ClipboardBadge" Visibility="Collapsed" Background="#3348E0C0" CornerRadius="6"
                            Padding="6,1" Margin="9,2,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="9" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"
                                  Stroke="#CFF7EC" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M8,3 H16 V21 H8 Z M10,3 V1.5 H14 V3"/>
                            <TextBlock Text="CLIPBOARD" Foreground="#CFF7EC" FontSize="9" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="RibbonDetail" Text="Ctrl + Alt + Space to finish" Foreground="#BFC3D4" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Rectangle x:Name="MeterOne" Width="3" Height="16" RadiusX="2" Fill="{StaticResource Signal}" Margin="2,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform/></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="MeterTwo" Width="3" Height="28" RadiusX="2" Fill="{StaticResource Signal}" Margin="2,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform/></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="MeterThree" Width="3" Height="20" RadiusX="2" Fill="{StaticResource Signal}" Margin="2,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform/></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="MeterFour" Width="3" Height="34" RadiusX="2" Fill="{StaticResource Signal}" Margin="2,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform/></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="MeterFive" Width="3" Height="14" RadiusX="2" Fill="{StaticResource Signal}" Margin="2,0" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform/></Rectangle.RenderTransform></Rectangle>
            </StackPanel>
        </Grid>
    </Border>
    </StackPanel>
</Window>

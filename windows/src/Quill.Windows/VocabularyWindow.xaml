<Window x:Class="Quill.Windows.VocabularyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add custom word" Width="500" Height="410" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Background="{StaticResource Paper}" Padding="26">
        <StackPanel>
            <TextBlock Text="CUSTOM VOCABULARY" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Teach Quill a preferred spelling" Style="{StaticResource Title}" FontSize="24" Margin="0,7,0,4"/>
            <TextBlock Text="Record or type what Quill hears, then tell it what to write instead."
                       Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,20"/>

            <TextBlock Text="Heard word" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                <TextBox x:Name="HeardField" ToolTip="The word or phrase Quill may hear"/>
                <Button Grid.Column="1" x:Name="RecordButton" Content="🎙" FontSize="18" Margin="8,0,0,0"
                        Style="{StaticResource GhostButton}" Click="RecordButton_Click" ToolTip="Record the heard word"/>
            </Grid>
            <TextBlock x:Name="RecordStatus" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,16"/>

            <TextBlock Text="Replaced word" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="ReplacementField" ToolTip="The spelling Quill should insert"/>

            <DockPanel Margin="0,26,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Save word" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Cancel_Click"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>

<Application x:Class="Quill.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Ink &amp; Signal — shared with Android, translated to native WPF tokens. -->
        <SolidColorBrush x:Key="Board" Color="#E6E8EF"/>
        <SolidColorBrush x:Key="Paper" Color="#EFF1F6"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Sunken" Color="#F6F7FB"/>
        <SolidColorBrush x:Key="Line" Color="#E3E5EE"/>
        <SolidColorBrush x:Key="LineStrong" Color="#D3D6E2"/>
        <SolidColorBrush x:Key="Ink" Color="#1C1B33"/>
        <SolidColorBrush x:Key="Ink2" Color="#4A4A5C"/>
        <SolidColorBrush x:Key="Muted" Color="#6E6E81"/>
        <SolidColorBrush x:Key="Faint" Color="#9A9AAC"/>
        <SolidColorBrush x:Key="Brand" Color="#4A3FD0"/>
        <SolidColorBrush x:Key="BrandInk" Color="#3A2EA3"/>
        <SolidColorBrush x:Key="BrandSoft" Color="#ECEAFB"/>
        <SolidColorBrush x:Key="Signal" Color="#E0A03A"/>
        <SolidColorBrush x:Key="SignalInk" Color="#8A5A12"/>
        <SolidColorBrush x:Key="SignalSoft" Color="#FBEFD6"/>
        <SolidColorBrush x:Key="Okay" Color="#2E9E6B"/>
        <SolidColorBrush x:Key="OkaySoft" Color="#E1F3EA"/>
        <SolidColorBrush x:Key="Error" Color="#D6453D"/>
        <SolidColorBrush x:Key="ErrorSoft" Color="#FBE7E5"/>

        <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI</FontFamily>
        <FontFamily x:Key="WordmarkFont">Palatino Linotype</FontFamily>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="{StaticResource Paper}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrandInk}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextBlock.FontStretch" Value="Expanded"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2,22,0,8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brand}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource BrandSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandInk}"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="{StaticResource BrandSoft}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="{StaticResource BrandSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background" Value="{StaticResource Sunken}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background" Value="{StaticResource Sunken}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,7"/>
        </Style>
    </Application.Resources>
</Application>

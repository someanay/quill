<Window x:Class="Quill.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Quill.Windows.Controls"
        Title="Quill" Width="1160" Height="760" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="20,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="4,0,0,30">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource Brand}">
                        <TextBlock Text="Q" Foreground="White" FontFamily="{StaticResource WordmarkFont}" FontWeight="Bold"
                                   FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Quill" FontFamily="{StaticResource WordmarkFont}" FontSize="25" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavButton}" Click="Home_Click" Content="Home"/>
                    <Button Style="{StaticResource NavButton}" Click="History_Click" Content="History"/>
                    <Button Style="{StaticResource NavButton}" Click="Settings_Click" Content="Settings"/>
                </StackPanel>
                <Border Grid.Row="2" Background="{StaticResource BrandSoft}" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="GLOBAL SHORTCUT" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding Hotkey}" Foreground="{StaticResource BrandInk}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding HotkeyStatus}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Tap to dictate. Hold to copy the text to your clipboard instead." Foreground="{StaticResource Muted}"
                                   FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/>
                        <Button x:Name="SidebarShortcutButton" Content="Open settings" Style="{StaticResource GhostButton}" Padding="10,6" Margin="0,10,0,0"
                                HorizontalAlignment="Left" Click="OpenSettings_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl x:Name="Pages" Grid.Column="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <Grid Margin="42,34,42,48" MaxWidth="900" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="CONTROL CENTER" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Dictate wherever you type." Style="{StaticResource Title}" Margin="0,7,0,6"/>
                            <TextBlock Text="Quill stays in your tray and listens only when you press the shortcut."
                                       Foreground="{StaticResource Muted}" FontSize="15"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,26,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="72" Height="72" CornerRadius="24" Background="{Binding StateBrush}">
                                    <Path Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M9,6 A3,3 0 0 1 15,6 V11 A3,3 0 0 1 9,11 Z M5,11 A7,7 0 0 0 19,11 M12,18 V21"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="20,5,28,0">
                                    <TextBlock Text="{Binding StatusTitle}" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,7,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="ToggleDictation_Click"
                                        Content="{Binding ActionLabel}" MinWidth="132" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="TODAY" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Text="{Binding TodayCount}" FontSize="34" FontWeight="Bold" Margin="0,8,0,0"/>
                                    <TextBlock Text="dictations" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="SPEECH PROVIDER" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Text="{Binding ProviderName}" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                    <TextBlock Text="Your key · direct connection" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="3" Background="{StaticResource SignalSoft}" CornerRadius="14" Padding="18" Margin="0,18,0,0">
                            <TextBlock Foreground="{StaticResource SignalInk}" FontSize="14">
                                <Run FontWeight="Bold" Text="Private by construction.  "/><Run Text="Audio is deleted after transcription. Quill runs no server for your data."/>
                            </TextBlock>
                        </Border>
                        <StackPanel Grid.Row="4" Margin="0,24,0,0">
                            <TextBlock Text="SEE QUILL IN ACTION" Style="{StaticResource SectionLabel}" Margin="2,0,0,9"/>
                            <controls:DemoCarousel AssetFolder="Home" Height="450"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <Grid Margin="42,34,42,42" MaxWidth="900" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="HISTORY" Style="{StaticResource Eyebrow}"/><TextBlock Text="Recent dictations" Style="{StaticResource Title}" Margin="0,7,24,0"/></StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource GhostButton}" Content="Clear history" Click="ClearHistory_Click"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,24,0,0">
                    <Border Visibility="{Binding HistoryEmptyVisibility}" Style="{StaticResource Card}" MinHeight="230">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                            <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource BrandSoft}"><Path Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource BrandInk}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M12,7.5 V12 L15.5,13.5"/></Border>
                            <TextBlock Text="Your words will appear here." FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                            <TextBlock Text="Complete a dictation to build a local, time-limited history - or turn history off in Settings." Foreground="{StaticResource Muted}" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ListBox Visibility="{Binding HistoryListVisibility}" ItemsSource="{Binding History}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Width="780">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" FontSize="15" Foreground="{StaticResource Ink2}" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="{Binding Application}" Foreground="{StaticResource BrandInk}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="  ·  " Foreground="{StaticResource Faint}"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:g}}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel Margin="42,34,42,52" MaxWidth="900" HorizontalAlignment="Stretch">
                        <TextBlock Text="SETTINGS" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Make dictation yours." Style="{StaticResource Title}" Margin="0,7,0,0"/>

                        <TextBlock Text="SPEECH" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Provider" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ComboBox x:Name="ProviderPicker" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider, Mode=OneWay}" SelectionChanged="ProviderPicker_SelectionChanged"/>
                                <TextBlock Grid.Row="1" Text="Model" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,16,0,0"/>
                                <ComboBox x:Name="ModelField" Grid.Row="1" Grid.Column="1" Margin="0,16,0,0"
                                          ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding Model}"
                                          Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" IsEditable="{Binding ModelAllowsFreeText}"
                                          ToolTip="Choose a listed model, or type one for OpenRouter/Custom."/>
                                <TextBlock Grid.Row="2" Text="Language code" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,16,0,0"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,16,0,0" ItemsSource="{Binding LanguageChoices}"
                                          SelectedItem="{Binding Language}" IsEditable="True" ToolTip="Choose a language or type an ISO code; auto detects the language"/>
                                <TextBlock Grid.Row="3" Text="Microphone" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,16,0,0"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0">
                                    <ComboBox Width="350" ItemsSource="{Binding InputDevices}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding InputDeviceId}"/>
                                    <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="RefreshInputDevices_Click"/>
                                </StackPanel>
                                <TextBlock Grid.Row="4" Text="Custom HTTPS endpoint" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,16,0,0"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CustomBaseUrl}" Margin="0,16,0,0"
                                         IsEnabled="{Binding IsCustomProvider}" ToolTip="Used only with the Custom provider"/>
                                <TextBlock Grid.Row="5" Text="API key" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,16,0,0"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0">
                                    <PasswordBox x:Name="ApiKeyField" Width="330"/>
                                    <Button Content="Test &amp; save key" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="SaveKey_Click"/>
                                    <Button Content="{Binding ProviderKeyLinkText}" IsEnabled="{Binding ProviderKeyLinkAvailable}"
                                            Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OpenProviderConsole_Click"/>
                                </StackPanel>
                                <Border Grid.Row="6" Grid.Column="1" CornerRadius="9" Padding="10,7" Margin="0,8,0,0">
                                    <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource ErrorSoft}"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding KeyStatusIsValid}" Value="True"><Setter Property="Background" Value="{StaticResource OkaySoft}"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding KeyStatus}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Error}"/><Style.Triggers><DataTrigger Binding="{Binding KeyStatusIsValid}" Value="True"><Setter Property="Foreground" Value="{StaticResource Okay}"/></DataTrigger></Style.Triggers></Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="DICTATION" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Content="Improve punctuation and capitalization" IsChecked="{Binding CleanupEnabled}"
                                          IsEnabled="{Binding CleanupAvailable}"/>
                                <TextBlock Text="{Binding CleanupHelp}" Foreground="{StaticResource Muted}" FontSize="12" Margin="24,-2,0,8"/>
                                <TextBlock Text="Cleanup model" FontWeight="SemiBold" Margin="0,10,0,5"/>
                                <ComboBox ItemsSource="{Binding CleanupModelChoices}" SelectedItem="{Binding CleanupModel}"
                                          IsEnabled="{Binding CleanupAvailable}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Stop recording after" VerticalAlignment="Center"/>
                                    <ComboBox Width="112" Margin="9,0" ItemsSource="{Binding SilenceChoices}" DisplayMemberPath="Label"
                                              SelectedValuePath="Seconds" SelectedValue="{Binding SilenceAutoStopSeconds}"/>
                                    <TextBlock Text="of silence." VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Writing style" FontWeight="SemiBold" Margin="0,15,0,5"/>
                                <ComboBox ItemsSource="{Binding WritingStyles}" SelectedItem="{Binding DefaultWritingStyle}"/>
                                <TextBlock Text="Maximum recording length" FontWeight="SemiBold" Margin="0,15,0,4"/>
                                <DockPanel Margin="0,3,0,0" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SessionCapLabel}" Foreground="{StaticResource BrandInk}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <Slider Style="{StaticResource QuillSlider}" Minimum="15" Maximum="630" TickFrequency="15" IsSnapToTickEnabled="True"
                                            SmallChange="15" LargeChange="60" Value="{Binding SessionCapSliderValue}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="15-second steps up to 10 minutes; the final stop is uncapped."
                                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                                <TextBlock Text="Custom vocabulary" FontWeight="SemiBold" Margin="0,15,0,5"/>
                                <Border Background="{StaticResource Sunken}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="9" Padding="10">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding CustomWords}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Heard}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Replacement}" Foreground="{StaticResource BrandInk}" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Tag="{Binding}" Style="{StaticResource GhostButton}" Padding="9,7" Click="RemoveCustomWord_Click" ToolTip="Remove word">
                                                            <Path Width="11" Height="11" Stretch="Uniform" Stroke="{StaticResource BrandInk}" StrokeThickness="1.8" StrokeStartLineCap="Round" Data="M5,5 L15,15 M15,5 L5,15"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="+  Add word" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="13,7" Click="AddCustomWord_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PRIVACY &amp; WINDOWS" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ToggleButton IsChecked="{Binding PrivateMode}" Style="{StaticResource HistoryModeSwitch}" HorizontalAlignment="Left" Width="248"
                                              ToolTip="Choose whether Quill keeps local dictation history."/>
                                <Grid Margin="0,6,0,5" IsEnabled="{Binding HistoryRetentionEnabled}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="History retention" VerticalAlignment="Center" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HistoryRetentionEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding RetentionChoices}" DisplayMemberPath="Label"
                                              SelectedValuePath="Minutes" SelectedValue="{Binding HistoryRetentionMinutes}"/>
                                </Grid>
                                <Grid Margin="0,10,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Global shortcut" FontWeight="SemiBold"/>
                                        <TextBlock Text="Use Change shortcut to pick a new combination." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,16,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBox x:Name="ShortcutField" Text="{Binding Hotkey}" IsReadOnly="True"
                                                 FontFamily="{StaticResource UtilityFont}" FontWeight="SemiBold"
                                                 Focusable="True" IsTabStop="True" Cursor="IBeam"
                                                 />
                                        <TextBlock Text="{Binding HotkeyStatus}" Foreground="{StaticResource Muted}"
                                                   FontSize="12" Margin="0,5,0,0"/>
                                        <Button x:Name="SettingsShortcutButton" Content="Change shortcut" Style="{StaticResource GhostButton}" Padding="10,6"
                                                HorizontalAlignment="Left" Margin="0,8,0,0" Click="ChangeHotkey_Click"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="Start Quill when I sign in" IsChecked="{Binding StartWithWindows}"/>
                                <CheckBox Content="Keep Quill in the notification area when closed" IsChecked="{Binding MinimizeToTray}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="APPEARANCE &amp; GUIDANCE" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Theme" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <StackPanel Grid.Column="1">
                                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"/>
                                    <TextBlock Text="Theme changes apply the next time Quill opens." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,18,20,0"><TextBlock Text="Setup guide" FontWeight="SemiBold"/><TextBlock Text="Review providers, privacy, and the shortcut." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                                <Button Grid.Row="1" Grid.Column="1" Content="Run setup again" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,18,0,0" Click="RunSetup_Click"/>
                            </Grid>
                        </Border>
                        <Button Content="Save settings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,20,0,0" Click="SaveSettings_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
